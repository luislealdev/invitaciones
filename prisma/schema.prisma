generator client {
    provider = "prisma-client-js"
}

// Data source configuration (PostgreSQL database)
datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        Int      @id @default(autoincrement())
    name      String
    email     String
    password  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Message {
    id        Int      @id @default(autoincrement())
    name      String
    content   String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
